[Unit]
Description=Back up NL Auth database and secrets
After=nl-auth.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/nl-auth-backup
User=root
Group=root
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/nl-auth
ReadOnlyPaths=/var/lib/nl-auth /etc/nl-auth
