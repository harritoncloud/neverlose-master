#include <Windows.h>
#include "resource.h"

IDR_INJECTOR RCDATA "assets\\injector.exe"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "patchwin.cc"
            VALUE "FileDescription", "Personal license loader"
            VALUE "FileVersion", "1.1.0"
            VALUE "InternalName", "nl-loader"
            VALUE "OriginalFilename", "nl-loader.exe"
            VALUE "ProductName", "patchwin.cc loader"
            VALUE "ProductVersion", "1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
